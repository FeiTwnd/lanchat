# 局域网聊天程序配置模板
# 复制为 config/chat.properties 后填写，修改后需重启程序。

# 服务器 TCP 端口
server.port=9527
# UDP 自动发现端口
discovery.port=30000
# 最大并发连接数
server.max.connections=200
# 客户端心跳间隔，单位毫秒
heartbeat.interval.ms=15000
# 服务端判定连接超时的时间，单位毫秒，需明显大于心跳间隔
heartbeat.timeout.ms=60000

# 接收文件的保存目录
file.received.dir=data/received
# 单个文件大小上限，单位字节，默认 200MB
file.max.size=209715200

# 首次启动且 admin 账号不存在时，用该口令创建管理员；留空则不创建
admin.password=

# JDBC 驱动类名
db.driver=com.mysql.cj.jdbc.Driver
# 数据库地址，serverTimezone 必须与数据库所在机器一致
db.url=jdbc:mysql://localhost:3306/lanchat?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&characterEncoding=utf8
db.username=root
db.password=

# 聊天记录加密口令，必填，留空时服务器拒绝启动
security.message.secret=

# 智能体小助手的工作流编号，与令牌同时填写后才启用
ai.workflow.id=
# 扣子平台个人访问令牌
ai.api.token=
# 智能体接口地址
ai.api.url=https://api.coze.cn/v1/workflow/run
